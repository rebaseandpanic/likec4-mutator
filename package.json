{
  "name": "likec4-mutator",
  "version": "0.4.2",
  "description": "Programmatic mutation of LikeC4 .c4 files",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "likec4-mutator": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@likec4/language-server": "^1.55.0",
    "bundle-require": "^5.1.0",
    "commander": "^12.0.0",
    "esbuild": "0.27.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "rebaseandpanic",
  "keywords": [
    "likec4",
    "c4",
    "architecture",
    "mutation",
    "dsl",
    "langium",
    "diagram"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebaseandpanic/likec4-mutator.git"
  }
}
